{
  "name": "thai-home-loan-planner",
  "productName": "Home Loan Planner",
  "version": "1.0.0",
  "description": "Plan a Thai home loan: compare banks, stress-test rates, track payments and prepare your application.",
  "author": "Henry Poudel <hennrywebworm@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "th.homeloan.planner",
    "productName": "Home Loan Planner",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "artifactName": "HomeLoanPlanner-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "HomeLoanPlanner-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "HomeLoanPlanner-${version}-setup.exe"
    },
    "publish": null,
    "copyright": "Developed by Henry Poudel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RoboPoudel/thai-home-loan-planner.git"
  }
}
